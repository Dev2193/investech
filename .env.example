# ---------------------------------------------------------------------------
# Web app (Vite) — public, build-time values only. Put them in .env (committed)
# or .env.local (local overrides, gitignored).
# ---------------------------------------------------------------------------

# URL of the deployed InvesTech API (the ./server app), without a trailing slash.
# Empty = same origin; in `npm run dev` Vite proxies /api to http://localhost:8787.
VITE_API_BASE_URL=""

# Optional (dev only): where the Vite dev server forwards /api (default http://localhost:8787)
# API_PROXY_TARGET=http://localhost:8787

# ---------------------------------------------------------------------------
# API server secrets do NOT go here. They belong to the server process:
# copy server/.env.example to server/.env for local dev, or set them on your host:
#   SEC_USER_AGENT (required), FINNHUB_API_KEY, FRED_API_KEY, OPENAI_API_KEY, ALLOWED_ORIGINS
# ---------------------------------------------------------------------------
