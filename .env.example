# ---------------------------------------------------------------------------
# Supabase (already set in .env by Lovable; public/anon values only)
# ---------------------------------------------------------------------------
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_URL=""

# ---------------------------------------------------------------------------
# Stock research data — LOCAL DEVELOPMENT ONLY (copy to .env.local, gitignored)
#
# In production these are NOT Vite variables: they are Supabase edge-function
# secrets used by supabase/functions/stock-research (never sent to the browser).
# ---------------------------------------------------------------------------

# Use the Vite dev-server copy of the data proxy instead of the deployed edge function.
VITE_RESEARCH_TRANSPORT=local

# Required by SEC EDGAR (keyless, but SEC asks for a contact): "AppName your@email.com"
SEC_USER_AGENT="InvesTech.AI you@yourdomain.com"

# Optional — free key at https://finnhub.io/register (peers, analyst ratings, news, market cap)
FINNHUB_API_KEY=""

# Optional — free key at https://fred.stlouisfed.org/docs/api/api_key.html
# (FRED data works without it via the public CSV download; the key uses the official API)
FRED_API_KEY=""
