# InvesTech.AI API server — copy to server/.env for local dev, or set these on your host.
PORT=8787

# Required for financials/industry/peers: SEC asks for "AppName contact@email"
SEC_USER_AGENT="InvesTech.AI you@yourdomain.com"

# Optional: free key at https://finnhub.io/register (peers, analyst ratings, news, market cap)
FINNHUB_API_KEY=

# Optional: free key at https://fred.stlouisfed.org/docs/api/api_key.html (keyless CSV is used otherwise)
FRED_API_KEY=

# Optional: enables the AI Assistant chat (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-2025-04-14

# Comma-separated browser origins allowed to call the API (CORS). "*" allows any.
# e.g. ALLOWED_ORIGINS=https://investech.ai,https://your-project.lovable.app
ALLOWED_ORIGINS=*

# Per-client request budgets (per minute)
# RATE_LIMIT_RESEARCH_PER_MIN=300
# RATE_LIMIT_CHAT_PER_MIN=20
